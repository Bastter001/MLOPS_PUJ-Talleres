{
    "policy_version": "1.0",
    "source_group": 8,
    "data_quality": {
        "minimum_valid_ratio": 0.80,
        "minimum_recent_records": 100
    },
    "initial_training": {
        "minimum_accumulated_records": 1000
    },
    "retraining": {
        "minimum_data_growth_ratio": 0.20,
        "psi_threshold": 0.25,
        "new_category_ratio_threshold": 0.05,
        "mae_degradation_threshold": 0.10
    },
    "promotion": {
        "minimum_mae_improvement": 0.03,
        "maximum_rmse_degradation": 0.01
    },
    "model": {
        "algorithm": "RandomForestRegressor",
        "n_estimators": 100,
        "max_depth": 16,
        "min_samples_leaf": 5,
        "random_state": 42,
        "n_jobs": 2
    },
    "preprocessing": {
        "unknown_categories": "ignore",
        "minimum_category_frequency": 10,
        "maximum_categories": 100
    },
    "evaluation": {
        "train_ratio": 0.70,
        "validation_ratio": 0.15,
        "test_ratio": 0.15,
        "primary_metric": "MAE",
        "secondary_metrics": [
            "RMSE",
            "R2",
            "MAPE"
        ]
    }
}
